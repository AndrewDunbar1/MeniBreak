\name{mbpr-package}
\alias{mbpr}
\alias{mbpr-package}
\title{Deterministic SEG-to-recurrence research software}
\description{
Normalizes segment-level copy-number data, extracts locked SCNA and breakpoint
features, and supports research scoring and external validation.
}
\details{
The package is for research use only and is not intended for diagnosis,
grading, treatment selection, or patient management.
}
